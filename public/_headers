# Security headers and HTML caching for every response.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; media-src 'self' https:; frame-src https:; connect-src 'self' https: wss:; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Long-lived caching for fingerprinted build output and static media.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/images/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Lead photos and API responses are never cached or indexed.
/api/*
  ! Cache-Control
  Cache-Control: no-store
  X-Robots-Tag: noindex
