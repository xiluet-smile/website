; xiluetsmiledesign.com — complete record set captured from the live SiteGround zone on 2026-10-06
; (including the GoHighLevel lc.* mail subdomain, app/go/portal and Stripe pay records the Cloudflare scan missed).
; Import in Cloudflare: zone → DNS → Records → Import and Export → Import DNS records (this file).
; The apex and www A records point at the current SiteGround server so the old site keeps serving
; during propagation; the Pages custom domain step replaces them afterwards.
$ORIGIN xiluetsmiledesign.com.
$TTL 300

; --- Web (old site, replaced by Cloudflare Pages at cutover) ---
@                       IN A     34.174.235.166
www                     IN A     34.174.235.166

; --- Email: Microsoft 365 ---
@                       IN MX 0  xiluetsmiledesign-com.mail.protection.outlook.com.
@                       IN TXT   "v=spf1 include:spf.protection.outlook.com -all"
@                       IN TXT   "MS=ms92957257"
autodiscover            IN CNAME autodiscover.outlook.com.
selector1._domainkey    IN CNAME selector1-xiluetsmiledesign-com._domainkey.xiluetsmiles.n-v1.dkim.mail.microsoft.
selector2._domainkey    IN CNAME selector2-xiluetsmiledesign-com._domainkey.xiluetsmiles.n-v1.dkim.mail.microsoft.
_dmarc                  IN TXT   "v=DMARC1; p=none; aspf=r; adkim=r;"

; --- Google Search Console verification (keep) ---
@                       IN TXT   "google-site-verification=RjWfUgmM5e48FRgXA5qL9qR6fw-aSsDF2my4jRJaUYw"

; --- SiteGround leftovers (harmless; delete once the old hosting is cancelled) ---
mail                    IN A     34.174.235.166
ftp                     IN A     34.174.235.166
default._domainkey      IN CNAME xiluetsmiledesign.com.default.dkim.auto.dnssmarthost.net.

; --- GoHighLevel / LeadConnector email sending (lc subdomain, via Mailgun) ---
lc                      IN MX 10 mxa.mailgun.org.
lc                      IN MX 10 mxb.mailgun.org.
lc                      IN TXT   "v=spf1 include:spf.leadconnectorhq.com include:mailgun.org ~all"
email.lc                IN CNAME mailgun.org.
mx._domainkey.lc        IN TXT   "k=rsa; p=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQD2WxCuk69IdiArB8Z2TDP+row7KyNZwIRl0PFnvwo1LntwnxKjBRR246g2ebgjakk5uDkrbgbvlG5MbQe7wj/LY1tIk2G8b7U0JJ6AgegjwAM5Tvt1w0KtY4zhNgsvB9uHYlYgkNTh0893c530hlJpoANfY6zp6ZjW0mVqhLu4HwIDAQAB"
_dmarc.lc               IN TXT   "v=DMARC1;p=none;"

; --- GoHighLevel white-label, funnels and client portal ---
app                     IN CNAME whitelabel.ludicrous.cloud.
go                      IN CNAME brand.ludicrous.cloud.
portal                  IN CNAME clientportal.ludicrous.cloud.

; --- Stripe hosted checkout ---
pay                     IN CNAME hosted-checkout.stripecdn.com.
_acme-challenge.pay     IN TXT   "EFi5ULnb5cCOgvTuz1StJmTkw7ebnWRn_HQot3qFiLw"

; --- SiteGround server aliases (unused once hosting is cancelled) ---
autoconfig              IN A     34.174.235.166
ssh                     IN A     34.174.235.166
